{
  "info": {
    "_postman_id": "edtech-platform-id",
    "name": "EdTech Platform API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"mobile\": \"9876543210\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/profile/USER_ID_HERE",
              "host": ["{{base_url}}"],
              "path": ["auth", "profile", "USER_ID_HERE"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Home Data",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/dashboard/home",
              "host": ["{{base_url}}"],
              "path": ["dashboard", "home"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "List Courses",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/courses?category=SSC",
              "host": ["{{base_url}}"],
              "path": ["courses"],
              "query": [
                {
                  "key": "category",
                  "value": "SSC"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Course Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/courses/COURSE_ID_HERE",
              "host": ["{{base_url}}"],
              "path": ["courses", "COURSE_ID_HERE"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Tests",
      "item": [
        {
          "name": "List Tests",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/tests",
              "host": ["{{base_url}}"],
              "path": ["tests"]
            }
          },
          "response": []
        },
        {
          "name": "Start Test",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"user_id\": \"USER_ID_HERE\",\n    \"test_id\": \"TEST_ID_HERE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/tests/start",
              "host": ["{{base_url}}"],
              "path": ["tests", "start"]
            }
          },
          "response": []
        },
        {
          "name": "Submit Test",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"attempt_id\": \"ATTEMPT_ID_HERE\",\n    \"answers\": [\n        {\n            \"question_index\": 0,\n            \"selected_option_index\": 1\n        }\n    ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/tests/submit",
              "host": ["{{base_url}}"],
              "path": ["tests", "submit"]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1"
    }
  ]
}
